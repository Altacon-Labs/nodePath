{
  "name": "nodepath",
  "private": true,
  "version": "0.1.0",
  "description": "Web3 Growth Intelligence Platform",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@nodepath/web",
    "dev:api": "npm run dev --workspace=@nodepath/api",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "build": "npm run check",
    "worker:indexer": "npm run start --workspace=@nodepath/indexer",
    "worker:analytics": "npm run start --workspace=@nodepath/analytics"
  }
}
