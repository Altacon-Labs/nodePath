{
  "name": "nodepath",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "nodepath",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "workers/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@nodepath/api",
      "version": "0.1.0",
      "dependencies": {
        "@nodepath/domain": "0.1.0"
      }
    },
    "apps/web": {
      "name": "@nodepath/web",
      "version": "0.1.0"
    },
    "node_modules/@nodepath/analytics": {
      "resolved": "workers/analytics",
      "link": true
    },
    "node_modules/@nodepath/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@nodepath/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@nodepath/indexer": {
      "resolved": "workers/indexer",
      "link": true
    },
    "node_modules/@nodepath/sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "node_modules/@nodepath/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/domain": {
      "name": "@nodepath/domain",
      "version": "0.1.0"
    },
    "packages/sdk": {
      "name": "@nodepath/sdk",
      "version": "0.1.0"
    },
    "workers/analytics": {
      "name": "@nodepath/analytics",
      "version": "0.1.0",
      "dependencies": {
        "@nodepath/domain": "0.1.0"
      }
    },
    "workers/indexer": {
      "name": "@nodepath/indexer",
      "version": "0.1.0",
      "dependencies": {
        "@nodepath/domain": "0.1.0"
      }
    }
  }
}
